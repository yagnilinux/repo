#!/bin/sh -e
# build every package, or the ones named
# skip built ones
# changed recipe? bump version
cd "${0%/*}"
ROOT=$PWD

# fetch name kind args...
#   shallow clone
#   ubuntu source, patched
#   ubuntu binaries, unpacked
fetch() {
    n=$1 kind=$2; shift 2
    t=src/$n.tmp && rm -rf "$t" && mkdir -p "$t"
    case $kind in
        git)     git clone -q --depth 1 --branch "$2" "$1" "$t/x" ;;
        apt-src) (cd "$t" && apt-get source -qq "$@" >/dev/null 2>&1) ;;
        apt-deb) (cd "$t" && apt-get download -qq "$@" 2>/dev/null &&
                  for p in *.deb; do dpkg-deb -x "$p" x; done && rm -f ./*.deb) ;;
    esac
    mv "$(find "$t" -mindepth 1 -maxdepth 1 -type d | head -n1)" "src/$n"
    rm -rf "$t"
}
# one bin, one share
# nothing in /usr /lib /sbin
flatten() (
    cd "$1"
    [ "$(readlink usr)" = . ] && u= || u=usr    # baselayout's usr -> .
    for s in ${u:+usr/bin usr/sbin} sbin; do
        [ -d "$s" ] || continue
        for f in "$s"/* "$s"/.[!.]*; do [ -e "$f" ] || [ -h "$f" ] || continue
            [ -e "bin/${f##*/}" ] && { echo "superlab: $2 has /$f and /bin/${f##*/}" >&2; exit 1; }
        done
        mkdir -p bin && cp -a "$s/." bin/ && rm -rf "$s"
    done
    [ "$u" ] && [ -d usr/share ] && mkdir -p share && cp -a usr/share/. share/ && rm -rf usr/share
    [ "$u" ] && { rmdir usr 2>/dev/null || :; }
    for x in $u lib lib64 sbin libexec; do
        [ -e "$x" ] && { echo "superlab: $2 installs into /$x" >&2; exit 1; }
    done
    :
)
command -v lzfse >/dev/null || { echo "superlab: needs lzfse on the build host (pkgs/lzfse)" >&2; exit 1; }
mkdir -p repo src
: > repo/index.tmp
for d in pkgs/*/; do
    [ -f "$d/build" ] || continue      # work in progress, not a package yet
    n=${d%/} n=${n##*/} v=$(cat "$d/version")
    deps=; [ -f "$d/depends" ] && deps=$(tr '\n' , < "$d/depends" | sed 's/,$//')
    out=repo/$n@$v.tar.lzfse
    want=1; [ $# -eq 0 ] || case " $* " in *" $n "*) ;; *) want= ;; esac   # cook names some
    if [ -z "$want" ]; then
        [ -f "$out" ] || continue
    elif [ -f "$out" ] && [ -n "$(find "$d" -newer "$out" | head -n1)" ]; then
        echo "superlab: $n changed but is still $v. Bump pkgs/$n/version." >&2; exit 1
    fi
    if [ "$want" ] && [ ! -f "$out" ]; then
        dir=$ROOT/$d
        if [ -f "$d/source" ]; then
            [ -d "src/$n" ] || fetch "$n" $(cat "$d/source")
            dir=$ROOT/src/$n
        fi
        dest=$(mktemp -d)
        (cd "$dir" && PKG=$ROOT/$d ROOT=$ROOT "$ROOT/$d/build" "$dest")
        flatten "$dest" "$n"
        tar cf - --owner=0 --group=0 --numeric-owner -C "$dest" . | lzfse -encode -o "$out"
        rm -rf "$dest"
        echo "-> $n $v built"
    fi
    sum=-; [ -z "$SUMS" ] || sum=$(sha256sum < "$out")   # SUMS=1 ./superlab to ship sums
    echo "$n $v ${sum%% *} ${deps:--}" >> repo/index.tmp
done
mv repo/index.tmp repo/index
