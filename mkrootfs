#!/bin/sh -e
# the install tarball
cd "${0%/*}"
r=$(mktemp -d) && chmod 755 "$r"    # tar puts this mode on the target
RAG_REPO=file://$PWD/repo sh src/rag/rag -r "$r" a sys/base >/dev/null
rm -rf "$r/var/db/rag/cache" "$r/var/db/rag/stage"
tar czf blackout.tar.gz --numeric-owner -C "$r" .
sha256sum blackout.tar.gz > blackout.tar.gz.sha256
rm -rf "$r"
echo "-> blackout.tar.gz $(wc -c < blackout.tar.gz) bytes"
