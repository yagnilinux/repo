#!/bin/sh -e
# static ffmpeg, no ffplay
"$ROOT/pkgs/desktop/kyrie/wlibs"; "$ROOT/pkgs/sound/alsa-utils/alsalib"
P=$ROOT/src/wlprefix A=$ROOT/src/alsa-prefix L=$ROOT/src/ffmpeg-libs W=$PWD
export PKG_CONFIG_LIBDIR="$L/lib/pkgconfig:$A/lib/pkgconfig:$P/lib/pkgconfig" PKG_CONFIG_PATH=
if [ ! -f "$L/.done" ]; then
    mkdir -p "$L/src" "$L/lib" "$L/include"; cd "$L/src"
    # mbedtls 3.6 upstream
    m=mbedtls-3.6.7 sum=a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6
    [ -f $m.tar.bz2 ] || curl -sfL -o $m.tar.bz2 "https://github.com/Mbed-TLS/mbedtls/releases/download/$m/$m.tar.bz2"
    echo "$sum  $m.tar.bz2" | sha256sum -c >/dev/null
    [ -d $m ] || tar xjf $m.tar.bz2
    cd "$L/src/$m"
    make -s -j"$(nproc)" CC=musl-cc CFLAGS="-O2 -I$A/kh" lib >/dev/null
    cp library/*.a "$L/lib/"; cp -r include/mbedtls include/psa "$L/include/"
    touch "$L/.done"
fi
cd "$W"

# verify https certs
sed -i 's/^#define TLS_VERIFY_DEFAULT 0/#define TLS_VERIFY_DEFAULT 1/
    /Certificate Authority database file/s|STRING, .flags|STRING, { .str = "/etc/ssl/certs/ca-certificates.crt" }, .flags|' libavformat/tls.h

# free encoders only
./configure --prefix=/usr --cc=musl-cc --pkg-config-flags=--static --disable-shared --enable-static \
    --disable-autodetect --disable-doc --disable-debug --enable-small --disable-ffprobe --disable-ffplay \
    --enable-version3 --enable-mbedtls --enable-zlib --enable-alsa \
    --disable-encoders --enable-encoder=aac,ac3,flac,alac,mp2,pcm_s16le,pcm_s24le,pcm_f32le \
    --enable-encoder=mpeg4,mpeg2video,mjpeg,png,gif,bmp,ffv1,rawvideo,wrapped_avframe \
    --enable-encoder=ass,srt,subrip,webvtt,mov_text \
    --extra-cflags="-I$L/include -I$A/include -I$P/include -I$A/kh" \
    --extra-ldflags="-static -L$L/lib -L$A/lib -L$P/lib" >/dev/null
make -s -j"$(nproc)" >/dev/null
install -Dm755 ffmpeg "$1/usr/bin/ffmpeg"
strip "$1/usr/bin/ffmpeg"
