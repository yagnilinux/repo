#!/bin/sh -e
# static python, openssl
"$ROOT/pkgs/luwm/wlibs"; "$ROOT/pkgs/alsa-utils/alsalib"
P=$ROOT/src/wlprefix K=$ROOT/src/alsa-prefix/kh L=$ROOT/src/python-libs W=$PWD
if [ ! -f "$L/.done" ]; then
    mkdir -p "$L/src"; cd "$L/src"
    [ -d openssl ] || git clone -q --depth 1 --branch openssl-3.5.9 https://github.com/openssl/openssl.git
    cd openssl
    CC=musl-gcc ./Configure linux-x86_64 no-shared no-tests no-docs no-dso no-engine no-module \
        --prefix="$L" --libdir=lib --openssldir=/etc/ssl -Os -I"$K" >/dev/null
    make -s -j"$(nproc)" build_libs >/dev/null 2>&1
    make -s install_dev >/dev/null 2>&1
    touch "$L/.done"
fi
cd "$W"
v=$(cat "$PKG/version") v=${v%.*}
# triplet mismatch workaround
grep -q print-multiarch configure && sed -i 's/^    MULTIARCH=$($CC --print-multiarch 2>\/dev\/null)/    MULTIARCH=/' configure
[ -f Makefile ] || CC=musl-gcc CFLAGS="-Os -I$K" LDFLAGS="-static" LINKFORSHARED=" " MODULE_BUILDTYPE=static \
    PKG_CONFIG_LIBDIR=/nonexistent ZLIB_CFLAGS="-I$P/include" ZLIB_LIBS="-L$P/lib -lz" \
    ./configure -q --prefix=/ --libdir=/share --with-platlibdir=share --disable-shared --with-openssl="$L" --with-openssl-rpath=no \
    --without-ensurepip --disable-test-modules >/dev/null 2>&1
make -s -j"$(nproc)" >/dev/null 2>&1
make -s DESTDIR="$1" install >/dev/null 2>&1

# drop tests and tk
cd "$1"
rm -rf include lib share/man share/pkgconfig share/libpython* bin/idle* bin/pydoc* bin/python3*-config bin/2to3*
cd "share/python$v"
rm -rf test idlelib tkinter turtledemo ensurepip lib2to3 pydoc_data config-* turtle.py
find . -name __pycache__ -prune -exec rm -rf {} +
strip "$1/bin/python$v"
ln -sf "python$v" "$1/bin/python"
