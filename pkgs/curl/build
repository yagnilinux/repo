#!/bin/sh -e
# static, bearssl, https
L=$ROOT/src/curl-libs W=$PWD
if [ ! -f "$L/.done" ]; then
    mkdir -p "$L/src" "$L/lib" "$L/include"; cd "$L/src"
    [ -d "$(ls -d bearssl-[0-9]*/ 2>/dev/null | head -n1)" ] || apt-get source -qq bearssl >/dev/null 2>&1
    cd "$(ls -d "$L"/src/bearssl-[0-9]*/ | head -n1)"
    make -s -j"$(nproc)" CC=musl-cc CFLAGS="-Os -fPIC" lib >/dev/null
    cp build/libbearssl.a "$L/lib/"; cp inc/*.h "$L/include/"
    touch "$L/.done"
fi
cd "$W"
CC=musl-cc CFLAGS=-Os ./configure -q --prefix=/usr --disable-shared --enable-static \
    --with-bearssl="$L" --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt \
    --without-zlib --without-brotli --without-zstd --without-libpsl --without-libidn2 \
    --without-nghttp2 --without-librtmp --without-libssh --without-libssh2 \
    --disable-ldap --disable-ldaps --disable-rtsp --disable-dict --disable-telnet \
    --disable-tftp --disable-pop3 --disable-imap --disable-smb --disable-smtp \
    --disable-gopher --disable-mqtt --disable-ftp --disable-manual --disable-docs \
    --disable-ntlm --disable-doh --disable-netrc --disable-unix-sockets \
    --disable-threaded-resolver --disable-libcurl-option --disable-websockets >/dev/null
make -s -j"$(nproc)" LDFLAGS="-all-static -s -L$L/lib" >/dev/null
install -Dm755 src/curl "$1/usr/bin/curl"
