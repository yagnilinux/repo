#!/bin/sh -e
# IM Fell English
# google/fonts, pinned
u=https://raw.githubusercontent.com/google/fonts/29b4ec6df2522a8aee279414b78a07910b065874/ofl/imfellenglish
d=$1/usr/share/fonts/imfell
mkdir -p "$d" "$1/usr/share/licenses/imfell"
for f in IMFeENrm28P.ttf IMFeENit28P.ttf; do curl -sfL -o "$d/$f" "$u/$f"; done
curl -sfL -o "$1/usr/share/licenses/imfell/OFL.txt" "$u/OFL.txt"
sha256sum -c >/dev/null <<S
fe9705bbde51af802719246d4608d08d37bde956ab99d9a590da996a5221a24c  $d/IMFeENrm28P.ttf
47cd75dce54b1f2e0831359d22d5e688f519d68ae45706b664fd310fd0e3ccf7  $d/IMFeENit28P.ttf
2a3ca501fc4d5efcad9798531e3e06962b1e20c60e464f6cbd6c17630112c773  $1/usr/share/licenses/imfell/OFL.txt
S
