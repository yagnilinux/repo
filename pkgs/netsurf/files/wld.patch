+static long long
+now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000LL + ts.tv_nsec / 1000000;
+}
+
+static void
+push_key(struct wld_connection *connection, int type, enum nsfb_key_code_e code)
+{
+    struct wld_event *event = calloc(1, sizeof(struct wld_event));
+    if (event == NULL)
+	return;
+    event->event.type = type;
+    event->event.value.keycode = code;
+    enqueue_wld_event(connection, event);
+}
+
+static void
+kb_keymap(void *data, struct wl_keyboard *kb, uint32_t format, int32_t fd, uint32_t size)
+{
+    UNUSED(data); UNUSED(kb); UNUSED(format); UNUSED(size);
+    close(fd); /* keymap unused */
+}
+
+static void
+kb_enter(void *data, struct wl_keyboard *kb, uint32_t serial, struct wl_surface *surface, struct wl_array *keys)
+{
+    UNUSED(data); UNUSED(kb); UNUSED(serial); UNUSED(surface); UNUSED(keys);
+}
+
+static void
+kb_leave(void *data, struct wl_keyboard *kb, uint32_t serial, struct wl_surface *surface)
+{
+    struct wld_input *input = data;
+    UNUSED(kb); UNUSED(serial); UNUSED(surface);
+    input->connection->rkey = 0;
+}
+
+static void
+kb_key(void *data, struct wl_keyboard *kb, uint32_t serial, uint32_t time, uint32_t key, uint32_t state)
+{
+    struct wld_input *input = data;
+    struct wld_connection *c = input->connection;
+    enum nsfb_key_code_e code;
+    UNUSED(kb); UNUSED(serial); UNUSED(time);
+
+    if (key > KEY_RIGHTMETA || (code = keymap[key]) == NSFB_KEY_UNKNOWN)
+	return;
+    if (state == WL_KEYBOARD_KEY_STATE_PRESSED) {
+	push_key(c, NSFB_EVENT_KEY_DOWN, code);
+	if (code < NSFB_KEY_NUMLOCK) /* no modifier repeat */
+	    c->rkey = code, c->rnext = now_ms() + 500;
+    } else {
+	push_key(c, NSFB_EVENT_KEY_UP, code);
+	if (c->rkey == (int)code)
+	    c->rkey = 0;
+    }
+}
+
+static void
+kb_mods(void *data, struct wl_keyboard *kb, uint32_t serial, uint32_t d, uint32_t l, uint32_t k, uint32_t g)
+{
+    UNUSED(data); UNUSED(kb); UNUSED(serial); UNUSED(d); UNUSED(l); UNUSED(k); UNUSED(g);
+}
