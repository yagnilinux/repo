#!/bin/sh -e
# dmenu for swc
"$ROOT/pkgs/luwm/wlibs"
P=$ROOT/src/wlprefix
export PATH="$P/bin:$PATH" PKG_CONFIG="pkg-config --static"
export PKG_CONFIG_LIBDIR="$P/lib/pkgconfig:$P/share/pkgconfig" PKG_CONFIG_PATH=

# wld, wayland backend
w=$(mktemp -d)
cp -a "$ROOT/src/wlsrc/wld/." "$w/src"
make -s -C "$w/src" clean >/dev/null 2>&1 || :
make -s -C "$w/src" PREFIX="$w" CC=musl-gcc CFLAGS="-Os -I$P/kh" ENABLE_DEBUG=0 ENABLE_SHARED=0 \
    ENABLE_STATIC=1 ENABLE_DRM=0 ENABLE_WAYLAND=1 WAYLAND_INTERFACES=shm DRM_DRIVERS= install >/dev/null

# blue colours
sed -e 's/"#bbbbbb", "#222222"/"#c3d0df", "#0c1726"/' -e 's/"#eeeeee", "#005577"/"#e6edf5", "#1a4270"/' \
    config.def.h > config.h
rm -f ./*.o dmenu
L="wayland-client xkbcommon fontconfig pixman-1 freetype2"
make -s CC=musl-gcc SWCPROTO="$P/share/swc/swc.xml" INCS="-I$w/include $($PKG_CONFIG --cflags $L)" \
    LDFLAGS="-static -s -L$w/lib -lwld $($PKG_CONFIG --libs $L) -lm" dmenu >/dev/null 2>&1
install -Dm755 dmenu "$1/usr/bin/dmenu"
install -Dm755 "$PKG/files/dmenu_run" "$1/usr/bin/dmenu_run"
rm -rf "$w"
