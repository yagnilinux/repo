#!/bin/sh -e
# borrow host kernel headers
kh=$(mktemp -d)
for d in linux asm-generic mtd; do ln -s "/usr/include/$d" "$kh/$d"; done
ln -s /usr/include/x86_64-linux-gnu/asm "$kh/asm"
sed "s|@KH@|$kh|" "$PKG/config" > .config
make -s HOSTCC=cc oldconfig </dev/null >/dev/null
make -j"$(nproc)" HOSTCC=cc CC=musl-cc >/dev/null
install -Dm755 busybox "$1/bin/busybox"
# every applet in /bin
./busybox --list | grep -vx busybox | while read -r a; do ln -s busybox "$1/bin/$a"; done
rm -rf "$kh"
