#!/bin/sh
# start kyrie
k=/share/X11/xkb
[ -d "$k" ] || k=/share/kyrie/xkb # our keymaps
export XKB_CONFIG_ROOT="${XKB_CONFIG_ROOT:-$k}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/run-$(id -u)}"
e=${XDG_CONFIG_HOME:-$HOME/.config}/kyrie/env
[ -f "$e" ] && { set -a; . "$e"; set +a; } # user settings
mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR" || exit 1
setwall # saved wallpaper
t=$(tty)
case $t in
/dev/tty[0-9]*) exec swc-launch -t "$t" -- kyrie "$@" ;; # this vt
*) exec swc-launch -- kyrie "$@" ;; # new vt
esac
