#!/bin/sh -e
# static, internal crypto
kh=$(mktemp -d)
for d in linux asm-generic; do ln -s "/usr/include/$d" "$kh/$d"; done
ln -s /usr/include/x86_64-linux-gnu/asm "$kh/asm"
cd wpa_supplicant
cat > .config <<C
CONFIG_DRIVER_WEXT=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_NO_RANDOM_POOL=y
CONFIG_GETRANDOM=y
C
make -s clean >/dev/null 2>&1 || :
make -j"$(nproc)" CC=musl-gcc EXTRA_CFLAGS="-Os -I$kh" LDFLAGS="-static -s" \
    wpa_supplicant wpa_cli wpa_passphrase >/dev/null
install -Dm755 wpa_supplicant "$1/usr/sbin/wpa_supplicant"
install -Dm755 wpa_cli "$1/usr/bin/wpa_cli"
install -Dm755 wpa_passphrase "$1/usr/bin/wpa_passphrase"
rm -rf "$kh"
