#!/bin/sh -e
# static swc wm
"$ROOT/pkgs/luwm/wlibs"
P=$ROOT/src/wlprefix
export PATH="$P/bin:$PATH" PKG_CONFIG="pkg-config --static"
export PKG_CONFIG_LIBDIR="$P/lib/pkgconfig:$P/share/pkgconfig" PKG_CONFIG_PATH=

# simpledrm, cursor, wallpaper/screenshots
s=$(mktemp -d)
cp -a "$ROOT/src/wlsrc/swc/." "$s"
for p in simpledrm cursor wall; do patch -sp1 -d "$s" < "$PKG/files/$p.patch"; done
make -s -C "$s" PREFIX="$P" CC=musl-gcc CFLAGS="-Os -fPIC -I$P/kh" ENABLE_DEBUG=0 ENABLE_SHARED=0 \
    ENABLE_STATIC=1 ENABLE_XWAYLAND=0 ENABLE_LIBUDEV=0 libswc/libswc.a >/dev/null
mkdir -p "$1/usr/bin"
musl-gcc -std=c11 -Os -s -static -I"$s/libswc" -I"$P/kh" -o "$1/usr/bin/luwm" \
    "$PKG/luwm.c" -L"$s/libswc" $($PKG_CONFIG --cflags --libs swc) -lm
rm -rf "$s"
strip -o "$1/usr/bin/swc-launch" "$P/bin/swc-launch"
chmod 4755 "$1/usr/bin/swc-launch" # setuid root
for f in startw setwall deadeye; do install -Dm755 "$PKG/files/$f" "$1/usr/bin/$f"; done
install -Dm644 "$PKG/files/keys" "$1/usr/share/luwm/keys"
musl-gcc -Os -s -static -I"$P/include" -o "$1/usr/bin/png" "$PKG/files/png.c" -L"$P/lib" -lz

# us keymap only
k=$(mktemp -d)
(cd "$k" && apt-get download -qq xkb-data 2>/dev/null && dpkg-deb -x xkb-data_*.deb x)
for f in rules/evdev keycodes/evdev keycodes/aliases symbols/pc symbols/us symbols/inet \
    symbols/keypad symbols/srvr_ctrl types/basic types/complete types/extra types/iso9995 \
    types/level5 types/mousekeys types/numpad types/pc compat/accessx compat/basic \
    compat/caps compat/complete compat/iso9995 compat/ledcaps compat/lednum \
    compat/ledscroll compat/level5 compat/misc compat/mousekeys compat/xfree86; do
    install -Dm644 "$k/x/usr/share/X11/xkb/$f" "$1/usr/share/luwm/xkb/$f"
done
rm -rf "$k"
