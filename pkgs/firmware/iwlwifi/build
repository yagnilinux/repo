#!/bin/sh -e
# newest intel firmware only
mkdir -p "$1/share/firmware"
cd lib/firmware
ls iwlwifi-* | sed -n 's/-\(c\{0,1\}[0-9]*\)\.ucode\.zst$/ \1/p' | sort -k1,1 -k2V |
    awk '{ last[$1] = $1 "-" $2 ".ucode.zst" } END { for (k in last) print last[k] }' > /tmp/iwl.$$
ls iwlwifi-* | grep -v '\.ucode\.zst$' >> /tmp/iwl.$$
while read -r f; do cp -L "$f" "$1/share/firmware/$f"; done < /tmp/iwl.$$
rm -f /tmp/iwl.$$
