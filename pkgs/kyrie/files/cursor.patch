-target_swap_buffers(struct target *target)
+target_swap_buffers(struct target *target, struct screen *screen, pixman_region32_t *damage)
 {
 	target->next_buffer = wld_surface_take(target->surface);
+	if (!screen->planes.cursor)
+		soft_cursor(target, target->next_buffer, damage);
 	return view_attach(target->view, target->next_buffer);
 }
 
