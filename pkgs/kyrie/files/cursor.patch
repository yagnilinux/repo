+/* software cursor */
+static void
+soft_cursor(struct target *target, struct wld_buffer *b, pixman_region32_t *damage)
+{
+	struct pointer *p = swc.seat->pointer;
+	struct wld_buffer *c = p->cursor.buffer;
+	const struct swc_rectangle *g = &p->cursor.view.geometry, *t = &target->view->geometry;
+	pixman_image_t *d, *s;
+
+	if (!b || !c || !p->cursor.view.buffer || !wld_map(b) || !wld_map(c))
+		return;
+	d = pixman_image_create_bits_no_clear(PIXMAN_x8r8g8b8, b->width, b->height, b->map, b->pitch);
+	s = pixman_image_create_bits_no_clear(PIXMAN_a8r8g8b8, c->width, c->height, c->map, c->pitch);
+	if (d && s) {
+		pixman_image_set_clip_region32(d, damage);
+		pixman_image_composite32(PIXMAN_OP_OVER, s, NULL, d, 0, 0, 0, 0, g->x - t->x, g->y - t->y, c->width, c->height);
+	}
+	if (d)
+		pixman_image_unref(d);
+	if (s)
+		pixman_image_unref(s);
+}
+
