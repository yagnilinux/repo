+compositor_damage_rect(int32_t x, int32_t y, uint32_t w, uint32_t h)
+{
+	pixman_region32_union_rect(&compositor.damage, &compositor.damage, x, y, w, h);
+	if (swc.active)
+		schedule_updates(-1);
+}
