#!/bin/sh -e
# plain python, copied
# qjs runs player js
mkdir -p "$1/share/yt-dlp" "$1/bin" "$1/etc"
cp -r yt_dlp "$1/share/yt-dlp/"
printf '#!/bin/sh\nPYTHONPATH=/share/yt-dlp exec python -m yt_dlp "$@"\n' > "$1/bin/yt-dlp"
chmod 755 "$1/bin/yt-dlp"
echo '--js-runtimes quickjs' > "$1/etc/yt-dlp.conf"
