#!/bin/sh -e
# build every package, or the ones named
# skip built ones
# changed recipe? bump version
cd "${0%/*}"
ROOT=$PWD
# clang, lld, compiler-rt. no gcc anywhere
export PATH=$ROOT/cc:$PATH AR=llvm-ar RANLIB=llvm-ranlib STRIP=llvm-strip NM=llvm-nm
[ -f cc/sysroot/usr/lib/libc.a ] || cc/mksysroot

# fetch name kind args...
#   shallow clone
#   ubuntu source, patched
#   ubuntu binaries, unpacked
fetch() {
    fn=$1 kind=$2; shift 2     # not n: the loop below needs it
    t=src/$fn.tmp && rm -rf "$t" && mkdir -p "$t"
    case $kind in
        git)     git clone -q --depth 1 --branch "$2" "$1" "$t/x" ;;
        apt-src) (cd "$t" && apt-get source -qq "$@" >/dev/null 2>&1) ;;
        apt-deb) (cd "$t" && apt-get download -qq "$@" 2>/dev/null &&
                  for p in *.deb; do dpkg-deb -x "$p" x; done && rm -f ./*.deb) ;;
    esac
    mv "$(find "$t" -mindepth 1 -maxdepth 1 -type d | head -n1)" "src/$fn"
    rm -rf "$t"
}
# one bin, one share
# nothing in /usr /lib /sbin
flatten() (
    cd "$1"
    [ "$(readlink usr)" = . ] && u= || u=usr    # baselayout's usr -> .
    for s in ${u:+usr/bin usr/sbin} sbin; do
        [ -d "$s" ] || continue
        for f in "$s"/* "$s"/.[!.]*; do [ -e "$f" ] || [ -h "$f" ] || continue
            [ -e "bin/${f##*/}" ] && { echo "mkrepo: $2 has /$f and /bin/${f##*/}" >&2; exit 1; }
        done
        mkdir -p bin && cp -a "$s/." bin/ && rm -rf "$s"
    done
    [ "$u" ] && [ -d usr/share ] && mkdir -p share && cp -a usr/share/. share/ && rm -rf usr/share
    [ "$u" ] && { rmdir usr 2>/dev/null || :; }
    for x in $u lib lib64 sbin libexec; do
        [ -e "$x" ] && { echo "mkrepo: $2 installs into /$x" >&2; exit 1; }
    done
    :
)
command -v lzfse >/dev/null || { echo "mkrepo: needs lzfse on the build host (crate/lzfse)" >&2; exit 1; }
mkdir -p repo src
: > repo/index.tmp
for d in crate/*/*/; do                 # crate/<category>/<name>
    [ -f "$d/build" ] || continue      # work in progress, not a package yet
    n=${d%/} n=${n#crate/} b=${n##*/} v=$(cat "$d/version")
    deps=; [ -f "$d/depends" ] && deps=$(tr '\n' , < "$d/depends" | sed 's/,$//')
    out=repo/$(echo "$n" | tr / .)@$v.tar.lzfse   # flat, release assets have no dirs
    want=1; [ $# -eq 0 ] || case " $* " in *" $n "*|*" $b "*) ;; *) want= ;; esac   # mkpkg names some
    if [ -z "$want" ]; then
        [ -f "$out" ] || continue
    elif [ -f "$out" ] && [ -n "$(find "$d" -newer "$out" | head -n1)" ]; then
        echo "mkrepo: $n changed but is still $v. Bump crate/$n/version." >&2; exit 1
    fi
    if [ "$want" ] && [ ! -f "$out" ]; then
        dir=$ROOT/$d
        if [ -f "$d/source" ]; then
            [ -d "src/$b" ] || fetch "$b" $(cat "$d/source")
            dir=$ROOT/src/$b
        fi
        dest=$(mktemp -d) && chmod 755 "$dest"   # mktemp makes 0700, which tar would ship
        fl=; [ -f "$d/fuel" ] && fl=$(sed -n 's/^+\([a-z0-9_]*\).*/F_\1=1/p' "$d/fuel")   # built with the defaults
        (cd "$dir" && env $fl PKG=$ROOT/$d ROOT=$ROOT "$ROOT/$d/build" "$dest")
        flatten "$dest" "$n"
        if [ -f "$d/app" ]; then        # an app ships as one folder
            a=$(mktemp -d) && chmod 755 "$a" && mkdir "$a/$b" && cp -a "$dest/." "$a/$b/" && echo "$v" > "$a/$b/version"
            rm -rf "$dest" && dest=$a
        fi
        tar cf - --owner=0 --group=0 --numeric-owner -C "$dest" . | lzfse -encode -o "$out"
        rm -rf "$dest"
        echo "-> $n $v built"
    fi
    # source for bottles a blackout machine can build itself
    srcout=repo/src.$(echo "$n" | tr / .)@$v.tar.lzfse
    if [ ! -f "$d/binonly" ] && [ -f "$d/source" ] && [ ! -f "$srcout" ] && [ -d "src/$b" ]; then
        if [ -e "src/$b/.git" ]; then git -C "src/$b" archive HEAD
        else tar cf - --exclude=.git -C "src/$b" .; fi | lzfse -encode -o "$srcout"
    fi
    sum=-; [ -z "$SUMS" ] || sum=$(sha256sum < "$out")   # SUMS=1 ./mkrepo to ship sums
    app=; [ -f "$d/app" ] && app=" app"
    echo "$n $v ${sum%% *} ${deps:--}$app" >> repo/index.tmp
done
mv repo/index.tmp repo/index
# the bottles themselves, for rag u
tar cf - --owner=0 --group=0 --numeric-owner -C crate . | lzfse -encode -o repo/crate.tar.lzfse
