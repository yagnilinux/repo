#!/bin/sh -e
# static framebuffer netsurf
# wayland surface, needs curl
"$ROOT/crate/desktop/barricade/wlibs"
P=$ROOT/src/wlprefix C=$ROOT/src/curl-libs L=$ROOT/src/netsurf-libs W=$PWD
[ -f "$ROOT/src/curl/lib/.libs/libcurl.a" ] || { echo "netsurf: build curl first" >&2; exit 1; }
# sub-libs ignore CFLAGS: give cc the paths
export CC="musl-cc -I$L/include -I$P/include" PKG_CONFIG="pkg-config --static" PKG_CONFIG_PATH=
export PKG_CONFIG_LIBDIR="$L/lib/pkgconfig:$P/lib/pkgconfig:$P/share/pkgconfig"
if [ ! -f "$L/.done" ]; then
    mkdir -p "$L/lib/pkgconfig"
    # reuse curl's libs
    cd "$ROOT/src/curl"
    make -s -C lib install prefix="$L" >/dev/null; make -s -C include install prefix="$L" >/dev/null
    make -s install-pkgconfigDATA prefix="$L" >/dev/null
    sed -i "s|^prefix=.*|prefix=$L|" "$L/lib/pkgconfig/libcurl.pc"
    cp "$C/lib/libbearssl.a" "$L/lib/"
    # png and jpeg, static
    mkdir -p "$L/src" && cd "$L/src"
    apt-get source -qq libpng1.6 libjpeg-turbo >/dev/null 2>&1
    cd "$L"/src/libpng1.6-*/
    CPPFLAGS="-I$P/include" LDFLAGS="-L$P/lib" ./configure -q --prefix="$L" --enable-static --disable-shared >/dev/null
    make -s -j"$(nproc)" install >/dev/null
    cd "$L"/src/libjpeg-turbo-*/ && mkdir -p b && cd b
    cmake .. -DCMAKE_C_COMPILER=musl-cc -DCMAKE_INSTALL_PREFIX="$L" -DCMAKE_INSTALL_LIBDIR="$L/lib" -DENABLE_SHARED=OFF \
        -DWITH_SIMD=OFF -DWITH_TURBOJPEG=OFF -DCMAKE_BUILD_TYPE=MinSizeRel >/dev/null
    make -s -j"$(nproc)" install >/dev/null
    touch "$L/.done"
fi
cd "$W"
# keys, wheel, resize
grep -q rkey libnsfb/src/surface/wld.c || patch -sp1 < "$PKG/files/wld.patch"
# one cursor, barricade's
grep -q "keep barricade" libnsfb/src/surface/wld.c || patch -sp1 < "$PKG/files/cursor.patch"
rm -rf libnsfb/build-* netsurf/nsfb netsurf/build/*/deps/link*.d inst-framebuffer/build-stamp
CFLAGS="-Os -I$L/include -I$P/include -I$P/include/freetype2 -I$P/kh" LDFLAGS="-static -s -L$L/lib -L$P/lib" \
# build-time tools need png and zlib too, ours
make TARGET=framebuffer HOST_CC=cc BUILD_CC="cc -static -I$L/include -I$P/include -L$L/lib -L$P/lib" PREFIX=/usr \
    BUILD_LIBPNG_LDFLAGS="-lpng16 -lz -lm" NETSURF_USE_OPENSSL=NO NETSURF_USE_SDL=NO \
    NETSURF_USE_VNC=NO NETSURF_USE_ROSPRITE=NO NETSURF_USE_RSVG=NO NETSURF_USE_WEBP=NO \
    NETSURF_USE_JPEGXL=NO NETSURF_USE_NSSVG=NO NETSURF_FB_FONTLIB=freetype \
    NETSURF_FB_FONTPATH=/share/fonts/dejavu NETSURF_FB_RESPATH='$${NETSURFRES}:/share/netsurf/' >/dev/null 2>&1
install -Dm755 netsurf/nsfb "$1/usr/bin/nsfb"
mkdir -p "$1/usr/share/netsurf"
cp -rL netsurf/frontends/framebuffer/res/. "$1/usr/share/netsurf/"
rm -rf "$1/usr/share/netsurf/de" "$1/usr/share/netsurf/fr" "$1/usr/share/netsurf/it" \
       "$1/usr/share/netsurf/ja" "$1/usr/share/netsurf/nl" "$1/usr/share/netsurf/fonts"
# an app: finds its resources next to itself
printf '#!/bin/sh\nd=$(cd "${0%%/*}/.." && pwd)\nNETSURFRES=$d/share/netsurf/ exec "$d/bin/nsfb" -f wld -w "${NSW:-800}" -h "${NSH:-600}" "$@"\n' > "$1/usr/bin/netsurf"
chmod 755 "$1/usr/bin/netsurf"
