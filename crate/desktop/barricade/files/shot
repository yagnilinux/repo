#!/bin/sh
# screenshot barricade
# png to file/stdout
r=${XDG_RUNTIME_DIR:-/tmp/run-$(id -u)}/snap.ppm
rm -f "$r"
pkill -USR2 -x barricade || { echo "shot: barricade not running" >&2; exit 1; }
i=0
while [ ! -f "$r" ]; do
    sleep 0.1; i=$((i + 1))
    [ $i -lt 50 ] || { echo "shot: no answer" >&2; exit 1; }
done
case $1 in
'') png -e < "$r" ;;
*.ppm) mv "$r" "$1" ;;
*) png -e < "$r" > "$1" ;;
esac
